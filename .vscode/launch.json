{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Development",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm install && pnpm run dev",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Next.js: Build",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm install && pnpm run lint:fix && pnpm run lint && pnpm run format && pnpm run test && pnpm run build"
    },
    {
      "name": "Next.js: Preview",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm run start"
    }
  ]
}
